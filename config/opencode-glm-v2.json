{
  "$schema": "https://opencode.ai/config.json",
  "model": "slurm-glm/glm-5.3-flash",
  "providers": {
    "slurm-glm": {
      "name": "GLM on Slurm",
      "env": ["GLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8001/v1"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash (Unsloth Q4 GGUF)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  }
}
