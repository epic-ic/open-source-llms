{
  "$schema": "https://opencode.ai/config.json",
  "model": "slurm-qwen/qwen3.8-27b",
  "providers": {
    "slurm-qwen": {
      "name": "Qwen on Slurm",
      "env": ["QWEN_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (Unsloth GGUF)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
